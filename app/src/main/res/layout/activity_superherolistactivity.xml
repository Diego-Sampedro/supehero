<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.users.presentation.UserActivity">


    <TextView
        android:id="@+id/label_name1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/superheroe_name1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/label_name1"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Superheroe1"/>

    <TextView
        android:id="@+id/label_name2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_name"
        app:layout_constraintTop_toBottomOf="@id/superheroe_name1"
        app:layout_constraintStart_toStartOf="parent"/>


    <TextView
        android:id="@+id/superheroe_name2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/label_name2"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Superheroe2"/>

    <TextView
        android:id="@+id/label_name3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_name"
        app:layout_constraintTop_toBottomOf="@id/superheroe_name2"
        app:layout_constraintStart_toStartOf="parent"/>


    <TextView
        android:id="@+id/superheroe_name3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/label_name3"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Superheroe3"/>

</androidx.constraintlayout.widget.ConstraintLayout>